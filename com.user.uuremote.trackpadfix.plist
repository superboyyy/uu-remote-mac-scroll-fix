<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.uuremote.trackpadfix</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/UUTrackpadFix.app/Contents/MacOS/UUTrackpadFix</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>UU_TRACKPAD_SCALE</key>
        <string>0.18</string>
        <key>UU_TRACKPAD_REVERSE</key>
        <string>0</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/com.user.uuremote.trackpadfix.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.user.uuremote.trackpadfix.stderr.log</string>
</dict>
</plist>
